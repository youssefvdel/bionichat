{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "bionichat",
  "version": "0.1.0",
  "identifier": "com.bionichat.app",
  "build": {
    "frontendDist": "../dist",
    "beforeDevCommand": "bun run build && touch src-tauri/build.rs && cargo build -p core",
    "beforeBuildCommand": "bun run build && touch src-tauri/build.rs && cargo build -p core"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "bionichat",
        "decorations": false,
        "width": 1360,
        "height": 860,
        "minWidth": 1280,
        "minHeight": 720,
        "resizable": true,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
